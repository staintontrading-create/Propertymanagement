---
/**
 * Decorative backdrop: a 48px plan grid that fades out under a radial mask,
 * suggesting drawings and plans. The parent must be position: relative.
 */
interface Props {
  position?: 'right' | 'full' | 'left';
  class?: string;
}

const { position = 'right', class: className } = Astro.props;
---

<div class:list={['plan-grid', `plan-grid--${position}`, className]} aria-hidden="true"></div>

<style>
  .plan-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--pattern-plan-grid);
    background-size: var(--pattern-plan-size);
    opacity: 0.9;
  }

  .plan-grid--right {
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 78% 45%, #000 15%, transparent 70%);
    mask-image: radial-gradient(ellipse 60% 70% at 78% 45%, #000 15%, transparent 70%);
  }

  .plan-grid--left {
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 22% 45%, #000 15%, transparent 70%);
    mask-image: radial-gradient(ellipse 60% 70% at 22% 45%, #000 15%, transparent 70%);
  }

  .plan-grid--full {
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 20%, transparent 75%);
  }

  :global(.tone-inverse) .plan-grid,
  :global(.tone-primary) .plan-grid {
    --color-border: rgba(247, 245, 240, 0.14);
  }
</style>
