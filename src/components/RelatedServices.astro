---
/**
 * Two or three service cards chosen per page ("Works well with").
 */
import ServiceCard from './ServiceCard.astro';
import { getService } from '../data/services';
import type { ServiceSlug } from '../data/types';

interface Props {
  slugs: ServiceSlug[];
  headingLevel?: 3 | 4;
  class?: string;
}

const { slugs, headingLevel = 3, class: className } = Astro.props;
---

<div class:list={['related', className]}>
  {slugs.map((slug) => (
    <ServiceCard service={getService(slug)} headingLevel={headingLevel} />
  ))}
</div>

<style>
  .related {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .related {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .related > :global(:nth-child(3):last-child) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 56rem) {
    .related {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    }

    .related > :global(:nth-child(3):last-child) {
      grid-column: auto;
    }
  }
</style>
