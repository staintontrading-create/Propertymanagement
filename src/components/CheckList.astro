---
/**
 * Short list with brass-ringed check bullets: hero promises and "what you
 * receive" lists. `inline` lays the items out in two columns on wide screens.
 */
import Glyph from './Glyph.astro';

interface Props {
  items: string[];
  inline?: boolean;
  compact?: boolean;
  /** Hairline-ruled rows, matching the arranged-separately list. */
  ruled?: boolean;
  class?: string;
}

const { items, inline = false, compact = false, ruled = false, class: className } = Astro.props;
---

<ul class:list={['checklist', { 'checklist--inline': inline, 'checklist--compact': compact, 'checklist--ruled': ruled }, className]} role="list">
  {items.map((item) => (
    <li class="checklist__item">
      <span class="checklist__marker" aria-hidden="true">
        <Glyph name="check" size={14} strokeWidth={2.2} />
      </span>
      <span>{item}</span>
    </li>
  ))}
</ul>

<style>
  .checklist {
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .checklist__item {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .checklist__marker {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.1rem;
    border: 2px solid var(--tone-rule);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-success);
  }

  .checklist--compact {
    gap: var(--space-1);
    font-size: var(--step--1);
  }

  .checklist--compact .checklist__marker {
    width: 1.25rem;
    height: 1.25rem;
    margin-block-start: 0.15rem;
  }

  .checklist--ruled {
    gap: 0;
  }

  .checklist--ruled .checklist__item {
    padding-block: var(--space-3);
    border-top: 1px solid var(--tone-border);
  }

  .checklist--ruled .checklist__item:last-child {
    border-bottom: 1px solid var(--tone-border);
  }

  @media (min-width: 40rem) {
    .checklist--inline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2) var(--space-4);
    }
  }
</style>
