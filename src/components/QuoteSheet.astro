---
/**
 * QuoteSheet: an itemised written scope drawn as a document from the same
 * office as ReportCard (raised white card, hairline rules, sunken footer).
 * It never shows prices, currency or totals; only descriptions and quantities.
 *
 *   variant="items"       lines with an empty brass ring (to be approved),
 *                         a Qty column and a "Quoted separately" group.
 *   variant="milestones"  numbered milestones; completed ones carry a
 *                         "Photos sent" tag.
 */
import Glyph from './Glyph.astro';

interface Line {
  label: string;
  qty?: string;
  /** milestones only: overrides the default (first two complete). */
  done?: boolean;
}

interface Props {
  title?: string;
  reference?: string;
  lines?: Line[];
  separate?: string[];
  footer?: string;
  variant?: 'items' | 'milestones';
  class?: string;
  [key: string]: unknown;
}

const { variant = 'items', title = 'Written scope', reference = 'Ref 0418', class: className, lines: _l, separate: _s, footer: _f, ...rest } = Astro.props;
const milestones = variant === 'milestones';

const lines: Line[] =
  Astro.props.lines ??
  (milestones
    ? ['Strip-out', 'First fix', 'Tiling', 'Second fix', 'Snagging'].map((label) => ({ label }))
    : [
        { label: 'Replace tap cartridge, kitchen', qty: '1' },
        { label: 'Re-seal shower tray', qty: '1' },
        { label: 'Ease and adjust sticking door', qty: '2' },
        { label: 'Replace blown bulbs, hallway', qty: '3' },
      ]);
const separate: string[] =
  Astro.props.separate ?? (milestones ? [] : ['Rewiring of hallway sockets: quoted by a licensed electrician']);
const footer = Astro.props.footer ?? (milestones ? 'Running cost sheet updated with each milestone' : 'Sent for your approval');

const isDone = (line: Line, i: number) => line.done ?? i < 2;
const doneCount = milestones ? lines.filter(isDone).length : 0;
const summary = milestones
  ? `${title}, ${reference}: ${lines.length} numbered milestones, ${lines.map((l) => l.label).join(', ')}; photos sent for the first ${doneCount}. ${footer}.`
  : `${title}, ${reference}: ${lines.length} items awaiting approval, ${lines
      .map((l) => `${l.label}${l.qty ? ` (quantity ${l.qty})` : ''}`)
      .join('; ')}.${separate.length ? ` Quoted separately: ${separate.join('; ')}.` : ''} ${footer}.`;
---

<div class:list={['quote', `quote--${variant}`, className]} role="img" aria-label={summary} {...rest}>
  <div class="quote__sheet" aria-hidden="true">
    <div class="quote__head">
      <Glyph name="clipboard" size={20} class="quote__icon" />
      <span class="quote__title">{title}</span>
      <span class="quote__ref">{reference}</span>
    </div>

    {!milestones && (
      <div class="quote__cols">
        <span>Item</span>
        <span>Qty</span>
      </div>
    )}

    <ul class="quote__lines">
      {lines.map((line, i) => (
        <li class:list={['quote__line', { 'is-done': milestones && isDone(line, i) }]}>
          {milestones ? (
            <span class="quote__num">{String(i + 1).padStart(2, '0')}</span>
          ) : (
            <span class="quote__ring"></span>
          )}
          <span class="quote__label">{line.label}</span>
          {milestones ? (
            isDone(line, i) && (
              <span class="quote__tag">
                <Glyph name="camera" size={14} />
                Photos sent
              </span>
            )
          ) : (
            <span class="quote__qty">{line.qty ?? ''}</span>
          )}
        </li>
      ))}
    </ul>

    {separate.length > 0 && (
      <div class="quote__group">
        <span class="quote__eyebrow">Quoted separately</span>
        <ul class="quote__lines quote__lines--separate">
          {separate.map((item) => (
            <li class="quote__line">
              <Glyph name="dash" size={20} class="quote__dash" />
              <span class="quote__label">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <div class="quote__foot">{footer}</div>
  </div>
</div>

<style>
  .quote {
    --pad: clamp(1rem, 4vw, 1.5rem);
    width: 100%;
    max-width: 26rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--step--1);
    line-height: 1.4;
  }

  .quote__sheet {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .quote__head {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--pad);
    border-bottom: 1px solid var(--color-border);
  }

  .quote__icon {
    color: var(--color-accent-text);
  }

  .quote__title {
    flex: 1;
    font-size: var(--step-0);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-primary-strong);
  }

  .quote__ref,
  .quote__qty,
  .quote__num {
    font-variant-numeric: tabular-nums;
  }

  .quote__ref {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .quote__cols {
    display: flex;
    justify-content: space-between;
    padding: var(--space-1) var(--pad) 0.25rem;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.85em;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .quote__lines {
    list-style: none;
    margin: 0;
    padding: 0 var(--pad);
  }

  .quote__line {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) auto;
    align-items: start;
    column-gap: var(--space-1);
    padding-block: 0.625rem;
    border-top: 1px solid var(--color-border);
  }

  .quote__cols + .quote__lines > .quote__line:first-child,
  .quote__lines--separate > .quote__line:first-child {
    border-top: 0;
  }

  .quote__ring {
    width: 1rem;
    height: 1rem;
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-pill);
    justify-self: center;
    margin-top: 0.125rem; /* centres on the first line of text */
  }

  .quote__label {
    overflow-wrap: anywhere;
  }

  .quote__qty {
    min-width: 2ch;
    text-align: right;
    color: var(--color-text-muted);
  }

  .quote__group {
    border-top: 1px solid var(--color-border);
  }

  .quote__eyebrow {
    display: block;
    padding: var(--space-1) var(--pad) 0.25rem;
    color: var(--color-accent-text);
    font-weight: 600;
    font-size: 0.85em;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .quote__dash {
    color: var(--color-warning);
    justify-self: center;
    margin-top: 0.0625rem;
  }

  .quote__foot {
    padding: var(--space-1) var(--pad);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
  }

  /* Milestones */
  .quote--milestones .quote__line {
    grid-template-columns: 2ch minmax(0, 1fr) auto;
    column-gap: var(--space-2);
    padding-block: 0.75rem;
  }

  .quote--milestones .quote__lines > .quote__line:first-child {
    border-top: 0;
  }

  .quote__num {
    font-weight: 600;
    color: var(--color-accent-text);
  }

  .quote--milestones .quote__line:not(.is-done) .quote__label {
    color: var(--color-text-muted);
  }

  .quote__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-success);
    border-radius: var(--radius-pill);
    color: var(--color-success);
    font-weight: 600;
    font-size: 0.85em;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
