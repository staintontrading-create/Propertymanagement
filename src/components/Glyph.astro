---
/**
 * Monoline icon set. Every glyph is drawn on a 24x24 grid with a 1.5px
 * currentColor stroke, round caps and joins, so it recolours with the text
 * around it and reads the same on light and dark bands.
 *
 * Decorative by default (aria-hidden). Pass `label` when the icon carries
 * meaning on its own (for example an icon-only button).
 */
import type { IconName } from '../data/types';

export type GlyphName =
  | IconName
  | 'house'
  | 'key'
  | 'clipboard'
  | 'calendar'
  | 'camera'
  | 'envelope'
  | 'handset'
  | 'whatsapp'
  | 'message'
  | 'wrench'
  | 'roller'
  | 'bed'
  | 'magnifier'
  | 'sun'
  | 'check'
  | 'dash'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'menu'
  | 'close'
  | 'plus'
  | 'minus'
  | 'clock'
  | 'document'
  | 'shield'
  | 'user'
  | 'pin';

interface Props {
  name: GlyphName;
  size?: number | string;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, label, class: className, strokeWidth = 1.5 } = Astro.props;

const paths: Record<GlyphName, string> = {
  house: 'M3 11.5 12 4l9 7.5M5 10v10h14V10M10 20v-6h4v6',
  key: 'M14.5 3.5a5 5 0 1 0 0 10 5 5 0 0 0 0-10ZM10.5 12.5 3 20m3-3 2 2m-1-4 2 2',
  clipboard: 'M9 4h6v3H9zM9 4H7a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-2M9 12h6M9 16h6',
  calendar: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4M8 14h2M14 14h2',
  camera: 'M4 8h3l2-3h6l2 3h3v11H4zM12 10.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z',
  envelope: 'M3 6h18v12H3zM3 7l9 6 9-6',
  handset: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1Z',
  whatsapp: 'M12 3.5a8.5 8.5 0 0 0-7.3 12.8L3.5 20.5l4.3-1.1A8.5 8.5 0 1 0 12 3.5ZM9 8.5c.2-.5.6-.5.9-.5l.7 1.5-.6.9a6 6 0 0 0 3.2 3.2l.9-.6 1.5.7c0 .3 0 .7-.5.9-.6.4-1.4.5-2.2.2a7.5 7.5 0 0 1-4.2-4.2c-.3-.8-.2-1.6.3-2.1Z',
  message: 'M4 5h16v11H9l-5 4z',
  wrench: 'M14.5 3.5a5 5 0 0 0-4.7 6.7L3.5 16.5l4 4 6.3-6.3a5 5 0 0 0 6.7-4.7l-3 1.5-2.5-2.5 1.5-3Z',
  roller: 'M4 5h12v5H4zM16 7h4v5h-8v3M12 15v6',
  bed: 'M3 18V8h18v10M3 12h18M6 12V9.5h5V12',
  magnifier: 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM15.5 15.5 20 20',
  sun: 'M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4',
  check: 'm5 12.5 4.5 4.5L19 7.5',
  dash: 'M6 12h12',
  'arrow-right': 'M4 12h16m-6-6 6 6-6 6',
  'arrow-up-right': 'M7 17 17 7M9 7h8v8',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  plus: 'M12 5v14M5 12h14',
  minus: 'M5 12h14',
  clock: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16ZM12 8v4l3 2',
  document: 'M7 3h7l4 4v14H7zM14 3v4h4M10 12h5M10 16h5',
  shield: 'M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3ZM9.5 12l2 2 3.5-4',
  user: 'M12 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM4 21a8 8 0 0 1 16 0',
  pin: 'M12 21s-6-6-6-11a6 6 0 0 1 12 0c0 5-6 11-6 11ZM12 8a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z',
  // Service icons
  'property-management': 'M3 11.5 12 4l9 7.5M5 10v10h14V10M9 20v-5h6v5M10.5 15.5l1 1 2-2',
  handyman: 'M14.5 3.5a5 5 0 0 0-4.7 6.7L3.5 16.5l4 4 6.3-6.3a5 5 0 0 0 6.7-4.7l-3 1.5-2.5-2.5 1.5-3Z',
  renovations: 'M4 5h12v5H4zM16 7h4v5h-8v3M12 15v6',
  'short-term-rentals': 'M3 18V8h18v10M3 12h18M6 12V9.5h5V12M17 5.5l1-1.5 1 1.5',
  'property-handovers': 'M14.5 3.5a5 5 0 1 0 0 10 5 5 0 0 0 0-10ZM10.5 12.5 3 20m3-3 2 2m-1-4 2 2M17.5 7.5l1 1 2-2',
  'property-inspections': 'M10.5 4a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM15.5 15.5 20 20M8 10.5l1.8 1.8 3.2-3.5',
  'holiday-home-maintenance': 'M17 3v1.5M20.5 5.5l-1 1M12 4l6 5v3M3 11.5 9 7l3 2.4M5 10v10h14v-5M9 20v-5h6v5',
};

const d = paths[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['glyph', className]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <path d={d}></path>
</svg>

<style>
  .glyph {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }
</style>
