---
/**
 * "This is for you if…": a ruled list of owner situations in the second
 * person. A list, not cards, so it reads like a letter.
 */
import type { OwnerSituation } from '../data/types';

interface Props {
  items: OwnerSituation[];
  headingLevel?: 3 | 4;
  class?: string;
}

const { items, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<ul class:list={['situations', className]} role="list">
  {items.map((item) => (
    <li class="situations__item">
      <Heading class="situations__title">{item.title}</Heading>
      <p class="situations__text">{item.text}</p>
    </li>
  ))}
</ul>

<style>
  .situations {
    list-style: none;
  }

  .situations__item {
    display: grid;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    border-top: 1px solid var(--tone-border);
  }

  .situations__item:last-child {
    border-bottom: 1px solid var(--tone-border);
  }

  .situations__title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
    color: var(--tone-heading);
  }

  .situations__text {
    max-width: var(--measure);
  }

  @media (min-width: 48rem) {
    .situations__item {
      grid-template-columns: minmax(12rem, 5fr) 7fr;
    }
  }
</style>
