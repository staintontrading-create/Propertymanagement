---
/**
 * The short-term rental turnover loop drawn as a six-node ring. The ring,
 * arrowheads and node markers are inline SVG in currentColor and brass; the
 * step labels are real HTML text placed around the ring with trigonometry
 * computed here, so they reflow, recolour on dark bands and stay selectable.
 */
import Glyph from './Glyph.astro';

interface Props {
  nodes?: string[];
  class?: string;
}

const {
  nodes = ['Check-out', 'Clean', 'Inspect', 'Restock', 'Ready', 'Check-in'],
  class: className,
} = Astro.props;

const C = 160; // viewBox centre
const R = 82; // ring radius
const count = Math.max(nodes.length, 1);
const round = (n: number) => Math.round(n * 100) / 100;

// Angle 0 is the top; angles increase clockwise on screen.
const steps = nodes.map((label, i) => {
  const a = (-90 + (360 / count) * i) * (Math.PI / 180);
  const cos = Math.cos(a);
  const sin = Math.sin(a);
  // Labels to the side hang by a corner, so they get a longer reach to keep
  // the same visual gap from the marker as the labels above and below.
  const reach = R + 16 + 8 * Math.abs(cos);
  return {
    label,
    index: String(i + 1).padStart(2, '0'),
    cx: round(C + R * cos),
    cy: round(C + R * sin),
    // Label anchor as a percentage of the box, plus the translate that
    // parks the label's nearest edge on the anchor (radial placement).
    x: round(((C + reach * cos) / 320) * 100),
    y: round(((C + reach * sin) / 320) * 100),
    tx: round((cos - 1) * 50),
    ty: round((sin - 1) * 50),
    align: cos > 0.3 ? 'left' : cos < -0.3 ? 'right' : 'center',
    // Arrowhead midway to the next node, tangent to the ring, clockwise.
    arrowDeg: round(-90 + (360 / count) * (i + 0.5) + 90),
    arrowX: round(C + R * Math.cos(a + Math.PI / count)),
    arrowY: round(C + R * Math.sin(a + Math.PI / count)),
  };
});

const summary = `Turnover cycle: ${nodes.join(', ')}, then back to ${nodes[0]}.`;
---

<div class:list={['cycle', className]} role="img" aria-label={summary}>
  <svg
    class="cycle__ring"
    viewBox="0 0 320 320"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx={C} cy={C} r={R} vector-effect="non-scaling-stroke"></circle>
    {steps.map((s) => (
      <path
        d="M-6 -6 0 0 -6 6"
        vector-effect="non-scaling-stroke"
        transform={`translate(${s.arrowX} ${s.arrowY}) rotate(${s.arrowDeg})`}
      ></path>
    ))}
    {steps.map((s) => (
      <circle class="cycle__node" cx={s.cx} cy={s.cy} r="7" vector-effect="non-scaling-stroke"></circle>
    ))}
  </svg>

  <div class="cycle__centre" aria-hidden="true">
    <Glyph name="house" size={24} />
    <span>One stay</span>
  </div>

  <ol class="cycle__labels" aria-hidden="true">
    {steps.map((s) => (
      <li
        class="cycle__label"
        style={`left:${s.x}%;top:${s.y}%;--tx:${s.tx}%;--ty:${s.ty}%;text-align:${s.align}`}
      >
        <span class="cycle__index">{s.index}</span>
        <span class="cycle__name">{s.label}</span>
      </li>
    ))}
  </ol>
</div>

<style>
  .cycle {
    position: relative;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 1;
    color: var(--tone-text);
    font-family: var(--font-body);
    font-size: var(--step--1);
    line-height: 1.3;
  }

  .cycle__ring {
    display: block;
    width: 100%;
    height: auto;
  }

  .cycle__node {
    fill: var(--color-surface-raised);
    stroke: var(--tone-rule);
  }

  .cycle__centre {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    color: var(--tone-text-muted);
    white-space: nowrap;
  }

  .cycle__labels {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cycle__label {
    position: absolute;
    display: grid;
    gap: 0.125rem;
    transform: translate(var(--tx), var(--ty));
    font-weight: 500;
    white-space: nowrap;
  }

  .cycle__index {
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--tone-eyebrow);
  }
</style>
