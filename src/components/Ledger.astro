---
/**
 * The Ledger: the site's signature numbered process list. Each step ends
 * with the artefact the owner receives. Rendered as an ordered list with a
 * brass-ringed number, a ruled row and a dotted perforation between number
 * and text on wide screens.
 */
import Glyph from './Glyph.astro';
import type { ProcessStep } from '../data/types';

interface Props {
  steps: ProcessStep[];
  startAt?: number;
  headingLevel?: 3 | 4;
  class?: string;
}

const { steps, startAt = 1, headingLevel = 3, class: className } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

<ol class:list={['ledger', className]} start={startAt} role="list">
  {steps.map((step, i) => (
    <li class="ledger__step">
      <span class="ledger__number" aria-hidden="true">{startAt + i}</span>
      <div class="ledger__body">
        <Heading class="ledger__title">{step.title}</Heading>
        <p class="ledger__text">{step.text}</p>
        <p class="ledger__receive">
          <Glyph name="clipboard" size={18} class="ledger__receive-glyph" />
          <span><span class="ledger__receive-label">You receive:</span> {step.youReceive}</span>
        </p>
      </div>
    </li>
  ))}
</ol>

<style>
  .ledger {
    list-style: none;
  }

  .ledger__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--tone-border);
  }

  .ledger__step:last-child {
    border-bottom: 1px solid var(--tone-border);
  }

  .ledger__number {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--tone-rule);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  :global(.tone-inverse) .ledger__number,
  :global(.tone-primary) .ledger__number {
    background: var(--color-primary);
    color: var(--color-text-on-dark);
  }

  .ledger__title {
    font-family: var(--font-body);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--tone-heading);
    padding-block-start: 0.35rem;
  }

  .ledger__text {
    margin-block-start: var(--space-1);
    max-width: var(--measure);
  }

  .ledger__receive {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-block-start: var(--space-2);
    font-size: var(--step--1);
    color: var(--tone-text-muted);
    max-width: var(--measure);
  }

  .ledger__receive-glyph {
    color: var(--tone-rule);
    margin-block-start: 0.1em;
  }

  .ledger__receive-label {
    font-weight: 600;
    color: var(--tone-eyebrow);
  }

  @media (min-width: 40rem) {
    .ledger__step {
      gap: var(--space-4);
    }

    /* dotted perforation between the number column and the text */
    .ledger__step::before {
      content: '';
      position: absolute;
      top: var(--space-3);
      bottom: var(--space-3);
      left: calc(2.5rem + var(--space-2) - 2px);
      width: 4px;
      background: radial-gradient(circle, var(--tone-border) 1px, transparent 1.5px) 0 0 / 4px 4px repeat-y;
    }
  }
</style>
